Subject: [Driver] find Darwin flang intrinsic modules across OS versions

flang-rt installs the intrinsic modules under the build host triple
(arm64-apple-darwin25.6.0) while the driver looks up the deployment
triple (arm64-apple-macosx26.0.0), so -fintrinsic-modules-path is never
passed on Darwin and every derived type fails in FIR-to-LLVM. Fall back to
the installed Darwin directory with the same architecture.

--- a/clang/lib/Driver/ToolChain.cpp
+++ b/clang/lib/Driver/ToolChain.cpp
@@ -1175,7 +1175,20 @@
 std::optional<std::string> ToolChain::getDefaultIntrinsicModuleDir() const {
   SmallString<128> P(D.ResourceDir);
   llvm::sys::path::append(P, "finclude", "flang");
-  return getTargetSubDirPath(P);
+  if (auto Path = getTargetSubDirPath(P))
+    return Path;
+  // Darwin triples carry OS versions that differ between the build host and
+  // the deployment target, so match the installed directory by architecture.
+  if (!getTriple().isOSDarwin())
+    return {};
+  std::error_code EC;
+  for (llvm::vfs::directory_iterator It = getVFS().dir_begin(P, EC), End;
+       !EC && It != End; It.increment(EC)) {
+    llvm::Triple Installed(llvm::sys::path::filename(It->path()));
+    if (Installed.isOSDarwin() && Installed.getArch() == getTriple().getArch())
+      return std::string(It->path());
+  }
+  return {};
 }
 
 std::optional<std::string> ToolChain::getRuntimePath() const {
