set(_key "host=")
cmake_host_system_information(RESULT _host QUERY HOSTNAME)
string(APPEND _key "${_host}\n")
foreach (_var POLYREGION_TEST_PROFILE POLYREGION_TEST_TARGETS POLYINVOKE_TEST_TARGETS POLYTEST_SEED POLYTEST_PROFILE_DIR)
    string(APPEND _key "${_var}=$ENV{${_var}}\n")
endforeach ()
set(_dir "${PROFILE_DIR}")
if (DEFINED ENV{POLYTEST_PROFILE_DIR} AND NOT "$ENV{POLYTEST_PROFILE_DIR}" STREQUAL "")
    set(_dir "$ENV{POLYTEST_PROFILE_DIR}")
endif ()
file(GLOB _profiles "${_dir}/*.env")
list(SORT _profiles)
foreach (_profile IN LISTS _profiles)
    file(SHA256 "${_profile}" _hash)
    get_filename_component(_name "${_profile}" NAME)
    string(APPEND _key "${_name}=${_hash}\n")
endforeach ()
file(WRITE "${OUT}.tmp" "${_key}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
