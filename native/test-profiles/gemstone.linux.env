# Gemstone CUDA, HSA, HIP, OpenCL, Level Zero, and Vulkan providers.

# Codegen tests (polyc/polycpp/polyfc).
export POLYREGION_TEST_TARGETS=
POLYREGION_TEST_TARGETS+=:host@native!host@*
POLYREGION_TEST_TARGETS+=:cuda@sm_89!cuda@*Gemstone*
POLYREGION_TEST_TARGETS+=:hsa@gfx900!hsa@*
POLYREGION_TEST_TARGETS+=:hip@gfx900!hip@*Gemstone*
POLYREGION_TEST_TARGETS+=:opencl1_1@!opencl1_1@*Gemstone*
POLYREGION_TEST_TARGETS+=:spirv64_kernel@!spirv64_kernel@*Gemstone*
POLYREGION_TEST_TARGETS+=:level_zero@!level_zero@*Gemstone*
POLYREGION_TEST_TARGETS+=:spirv_glcompute@!spirv_glcompute@*Gemstone*

# Runtime tests (polyinvoke-tests).
export POLYINVOKE_TEST_TARGETS=
POLYINVOKE_TEST_TARGETS+=:host@native
POLYINVOKE_TEST_TARGETS+=:c11@native
POLYINVOKE_TEST_TARGETS+=:cuda@sm_89
POLYINVOKE_TEST_TARGETS+=:hsa@gfx900
POLYINVOKE_TEST_TARGETS+=:hip@gfx900
POLYINVOKE_TEST_TARGETS+=:opencl1_1@Gemstone
POLYINVOKE_TEST_TARGETS+=:spirv64_kernel@Gemstone
POLYINVOKE_TEST_TARGETS+=:level_zero@Gemstone
POLYINVOKE_TEST_TARGETS+=:spirv_glcompute@Gemstone

# Emulator settings.
export GEMSTONE_CUDA_TARGET=sm_89
export GEMSTONE_AMDGPU_TARGET=gfx900
export GEMSTONE_CUDA_SYSTEM_PAGING=1
export GEMSTONE_HSA_SYSTEM_PAGING=1
export POLYINVOKE_TEST_LOCK=0

# Launcher values required by compiled test processes.
export POLYTEST_FORWARD_ENV=
POLYTEST_FORWARD_ENV+=:GEMSTONE_RPC_PORT
POLYTEST_FORWARD_ENV+=:GEMSTONE_RPC_CLIENT
POLYTEST_FORWARD_ENV+=:GEMSTONE_RPC_TIMEOUT_SECONDS
POLYTEST_FORWARD_ENV+=:GEMSTONE_NATIVE_DIRECTORY
POLYTEST_FORWARD_ENV+=:OCL_ICD_FILENAMES
POLYTEST_FORWARD_ENV+=:OCL_ICD_VENDORS
POLYTEST_FORWARD_ENV+=:ZE_ENABLE_ALT_DRIVERS
POLYTEST_FORWARD_ENV+=:ZE_ENABLE_LOADER_DEBUG_TRACE
POLYTEST_FORWARD_ENV+=:POLYRT_JIT_LIB
POLYTEST_FORWARD_ENV+=:POLYRT_QUEUE_TIMEOUT_SEC
POLYTEST_FORWARD_ENV+=:GEMSTONE_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_CUDA_PAGING_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_HSA_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_HSA_PAGING_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_HIP_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_VULKAN_TRACE
POLYTEST_FORWARD_ENV+=:GEMSTONE_VULKAN_DUMP
